# Kisan Sahayak Platform - Environment Variables Template

# Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Environment Configuration
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DEFAULT_LANGUAGE=hi
NEXT_PUBLIC_ENABLE_VOICE=true

# External Agricultural Data APIs (Optional with graceful fallbacks)
# Weather: IMD or Open-Meteo
NEXT_PUBLIC_WEATHER_API_PROVIDER=open-meteo

# Mandi: Agmarknet via Data.gov.in
NEXT_PUBLIC_DATA_GOV_API_KEY=your_data_gov_in_api_key

# SMS / Notification Gateway (Optional - e.g. Twilio / Fast2SMS)
SMS_API_KEY=your_sms_api_key
